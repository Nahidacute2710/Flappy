cabal-version:      2.4
name:               flappy-bird-haskell
version:            0.1.0.0
build-type:         Simple

executable flappy-bird-api
  main-is:          Main.hs
  hs-source-dirs:   app, src/Game
  other-modules:
      ApiJSON
      GameState
      Config
      Geometry
      Input
      GameLoop
      Physics
      Stage
      PipeSystem
      Simulation
      Leaderboard
      Achievement
      Analyzer
      CommandParser
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.14 && <5
    , aeson >=2.0
    , bytestring
    , text
    , scotty
    , wai
    , wai-cors
    , parallel
    , deepseq
    , random
    , directory
    , filepath
    , time
    , parsec

executable test-parser
  main-is:          TestParser.hs
  hs-source-dirs:   app, src/Game
  other-modules:
      CommandParser
  default-language: Haskell2010
  build-depends:
      base >=4.14 && <5
    , parsec
